# Server Port
PORT=3001

# MongoDB Connection String (Standard replica-set format)
MONGO_URI=mongodb://db_user:db_password@cluster0-shard-00-00.xxxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxxx.mongodb.net:27017/test?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
